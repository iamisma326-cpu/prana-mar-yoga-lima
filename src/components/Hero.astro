---
---

<section
  id="inicio"
  class="relative pt-36 pb-20 md:pt-44 md:pb-28 lg:pt-48 lg:pb-32 overflow-hidden bg-grain"
>
  <!-- Círculo orgánico ambiental -->
  <div
    class="pointer-events-none absolute -top-24 right-0 w-[28rem] h-[28rem] rounded-full bg-terracotta-400/10 blur-3xl"
    aria-hidden="true"
  ></div>
  <div
    class="pointer-events-none absolute bottom-10 -left-24 w-[24rem] h-[24rem] rounded-full bg-sage-500/10 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="editorial-container relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-10 items-center">
      <!-- Columna Editorial Izquierda -->
      <div class="lg:col-span-7 space-y-8">
        <div class="hero-animate inline-flex items-center gap-3 rounded-full bg-sand-100 border border-sand-300/80 px-4 py-1.5">
          <span class="w-2 h-2 rounded-full bg-terracotta-500"></span>
          <span class="text-xs uppercase tracking-[0.2em] font-medium text-ink-800">
            Santuario de Movimiento &amp; Respiración en Lima
          </span>
        </div>

        <h1 class="hero-animate font-serif text-5xl sm:text-6xl lg:text-[4.35rem] leading-[1.04] tracking-tight text-ink-900">
          Habita tu cuerpo al ritmo de la <span class="italic font-normal text-terracotta-600">brisa del Pacífico</span>.
        </h1>

        <p class="hero-animate text-base sm:text-lg text-ink-700 max-w-xl leading-relaxed font-normal">
          En el corazón bohemio de <strong>Barranco</strong>, creamos un refugio de luz natural, madera cálida y silencio consciente. Prácticas de Vinyasa, Hatha Tradicional, Yin Yoga y Baños de Sonido diseñadas para pausar el vértigo de la ciudad.
        </p>

        <div class="hero-animate flex flex-wrap items-center gap-4 pt-2">
          <a href="#contacto" class="btn-primary">
            <span>Reservar clase de prueba · S/ 35</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="#horarios" class="btn-outline">
            Ver horarios de la semana
          </a>
        </div>

        <!-- Detalles de confianza -->
        <div class="hero-animate pt-6 border-t border-sand-300/70 grid grid-cols-3 gap-4 sm:gap-8 max-w-lg">
          <div>
            <p class="font-serif text-3xl sm:text-4xl font-semibold text-ink-900">14 máx.</p>
            <p class="text-xs text-ink-700 mt-0.5">Alumnos por sala para atención personalizada</p>
          </div>
          <div>
            <p class="font-serif text-3xl sm:text-4xl font-semibold text-ink-900">32+</p>
            <p class="text-xs text-ink-700 mt-0.5">Sesiones semanales de lunes a domingo</p>
          </div>
          <div>
            <p class="font-serif text-3xl sm:text-4xl font-semibold text-ink-900">100%</p>
            <p class="text-xs text-ink-700 mt-0.5">Mats de caucho natural e implementos incluidos</p>
          </div>
        </div>
      </div>

      <!-- Columna Visual Derecha con composición editorial -->
      <div class="lg:col-span-5 relative">
        <div class="hero-image-wrap relative mx-auto max-w-md lg:max-w-none">
          <!-- Marco arqueado principal -->
          <div class="relative rounded-t-[11rem] rounded-b-3xl overflow-hidden border border-sand-300 shadow-soft aspect-[4/5] bg-sand-200">
            <img
              src="https://images.unsplash.com/photo-1545205597-3d9d02c29597?auto=format&fit=crop&w=1200&q=85"
              alt="Práctica de yoga matutina con luz cálida entrando por los ventanales de nuestra casona en Barranco"
              class="hero-parallax-img w-full h-[112%] object-cover object-center"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-ink-900/45 via-transparent to-transparent"></div>
            <div class="absolute bottom-5 left-5 right-5 flex items-end justify-between text-sand-50">
              <div>
                <span class="text-[11px] uppercase tracking-[0.2em] text-sand-200 block">Sala Principal · Casona Domeyer</span>
                <p class="font-serif text-xl italic">Luz natural y pisos de huayruro restaurado</p>
              </div>
            </div>
          </div>

          <!-- Tarjeta flotante: Próxima sesión -->
          <div class="hero-floating-card absolute -bottom-6 -left-4 sm:-left-8 bg-sand-50/95 backdrop-blur-md border border-sand-300 rounded-2xl p-4 shadow-card max-w-[260px]">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-sage-100 text-sage-800">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
              <div>
                <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-terracotta-600 block">
                  Atardecer frente al mar
                </span>
                <p class="font-serif text-lg font-semibold text-ink-900 leading-snug">
                  Vinyasa &amp; Cuencos
                </p>
                <p class="text-xs text-ink-700">Hoy · 18:30 hrs · Con Mateo R.</p>
              </div>
            </div>
          </div>

          <!-- Sello circular superior -->
          <div class="hidden sm:flex absolute -top-6 -right-5 w-28 h-28 rounded-full bg-terracotta-600 text-sand-50 p-3 items-center justify-center text-center shadow-card border-4 border-sand-50">
            <p class="font-serif text-xs leading-tight tracking-wide">
              <span class="block uppercase text-[9px] tracking-[0.2em] opacity-80">Infusión</span>
              <span class="italic text-sm font-medium">Muña &amp; Cacao</span>
              <span class="block text-[10px] opacity-90 mt-0.5">al terminar</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
