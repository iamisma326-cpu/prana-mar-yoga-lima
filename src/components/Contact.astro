---
---

<section id="contacto" class="py-24 md:py-32 bg-sand-100 border-t border-sand-300">
  <div class="editorial-container">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Información de la Casona en Barranco -->
      <div class="lg:col-span-5 space-y-8 reveal-up">
        <div>
          <span class="eyebrow">Visítanos o Reserva</span>
          <h2 class="mt-3 font-serif text-4xl sm:text-5xl text-ink-900 leading-[1.08]">
            Tu mat te espera en <span class="italic font-normal text-terracotta-600">Barranco</span>.
          </h2>
          <p class="mt-4 text-sm sm:text-base text-ink-700 leading-relaxed">
            Reserva tu clase suelta de prueba (S/ 35) o tu semana introductoria ilimitada (S/ 89). Te confirmaremos por WhatsApp en menos de 15 minutos con indicaciones para llegar.
          </p>
        </div>

        <div class="space-y-5 bg-sand-50 p-7 rounded-3xl border border-sand-300">
          <div class="flex items-start gap-4">
            <span class="w-10 h-10 rounded-full bg-terracotta-500/15 text-terracotta-600 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </span>
            <div>
              <h3 class="font-serif text-xl font-semibold text-ink-900">Dirección en Lima</h3>
              <p class="text-sm text-ink-700 mt-0.5">Jr. Domeyer 248, Barranco 15063, Lima</p>
              <p class="text-xs text-ink-700 mt-1">A 2 cuadras del Malecón Pedro de Osma · Estacionamiento para bicicletas dentro de la casona.</p>
            </div>
          </div>

          <div class="flex items-start gap-4 pt-4 border-t border-sand-200">
            <span class="w-10 h-10 rounded-full bg-sage-500/15 text-sage-700 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </span>
            <div>
              <h3 class="font-serif text-xl font-semibold text-ink-900">WhatsApp Directo &amp; Correo</h3>
              <p class="text-sm text-ink-700 mt-0.5">+51 987 432 109 · hola@pranaymar.pe</p>
              <p class="text-xs text-ink-700 mt-1">Aceptamos Yape, Plin y todas las tarjetas en recepción.</p>
            </div>
          </div>

          <div class="flex items-start gap-4 pt-4 border-t border-sand-200">
            <span class="w-10 h-10 rounded-full bg-terracotta-500/15 text-terracotta-600 flex items-center justify-center shrink-0 mt-0.5">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </span>
            <div>
              <h3 class="font-serif text-xl font-semibold text-ink-900">Horario de Recepción</h3>
              <p class="text-sm text-ink-700 mt-0.5">Lunes a Viernes: 06:30 – 21:30 hrs</p>
              <p class="text-sm text-ink-700">Sábados y Domingos: 08:00 – 19:30 hrs</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Formulario interactivo -->
      <div class="lg:col-span-7 reveal-up">
        <form
          id="booking-form"
          class="bg-sand-50 rounded-3xl p-8 sm:p-10 border border-sand-300 shadow-soft space-y-6"
          novalidate
        >
          <div class="flex items-center justify-between border-b border-sand-200 pb-4">
            <div>
              <h3 class="font-serif text-2xl sm:text-3xl font-semibold text-ink-900">
                Reserva tu espacio en el mat
              </h3>
              <p class="text-xs text-ink-700 mt-1">
                Sin pago por adelantado obligatorio · Confirmación inmediata
              </p>
            </div>
            <span class="hidden sm:inline-flex rounded-full bg-sage-100 text-sage-800 px-3.5 py-1 text-xs font-medium">
              Cupos limitados (14 por sala)
            </span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="name" class="block text-xs uppercase tracking-[0.14em] font-semibold text-ink-800 mb-2">
                Nombre completo *
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Ej. Camila Mendoza"
                class="w-full rounded-xl border border-sand-300 bg-sand-100/50 px-4 py-3 text-sm text-ink-900 placeholder:text-ink-700/50 focus:border-terracotta-500 focus:bg-sand-50 focus:outline-none"
              />
            </div>

            <div>
              <label for="phone" class="block text-xs uppercase tracking-[0.14em] font-semibold text-ink-800 mb-2">
                WhatsApp (Perú) *
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="+51 999 888 777"
                class="w-full rounded-xl border border-sand-300 bg-sand-100/50 px-4 py-3 text-sm text-ink-900 placeholder:text-ink-700/50 focus:border-terracotta-500 focus:bg-sand-50 focus:outline-none"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div>
              <label for="email" class="block text-xs uppercase tracking-[0.14em] font-semibold text-ink-800 mb-2">
                Correo electrónico *
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="camila@correo.pe"
                class="w-full rounded-xl border border-sand-300 bg-sand-100/50 px-4 py-3 text-sm text-ink-900 placeholder:text-ink-700/50 focus:border-terracotta-500 focus:bg-sand-50 focus:outline-none"
              />
            </div>

            <div>
              <label for="experience" class="block text-xs uppercase tracking-[0.14em] font-semibold text-ink-800 mb-2">
                Tu experiencia previa
              </label>
              <select
                id="experience"
                name="experience"
                class="w-full rounded-xl border border-sand-300 bg-sand-100/50 px-4 py-3 text-sm text-ink-900 focus:border-terracotta-500 focus:bg-sand-50 focus:outline-none"
              >
                <option value="Primera vez">Es mi primera vez haciendo yoga</option>
                <option value="Principiante">He practicado algunas veces</option>
                <option value="Intermedio">Práctica regular / Intermedio</option>
                <option value="Avanzado">Práctica constante / Avanzado</option>
              </select>
            </div>
          </div>

          <div>
            <label for="interest" class="block text-xs uppercase tracking-[0.14em] font-semibold text-ink-800 mb-2">
              Clase o membresía de interés
            </label>
            <input
              type="text"
              id="interest"
              name="interest"
              value="Clase de prueba (S/ 35) — Vinyasa o Hatha"
              class="w-full rounded-xl border border-sand-300 bg-sand-100/50 px-4 py-3 text-sm text-ink-900 focus:border-terracotta-500 focus:bg-sand-50 focus:outline-none"
            />
          </div>

          <div>
            <label for="notes" class="block text-xs uppercase tracking-[0.14em] font-semibold text-ink-800 mb-2">
              ¿Alguna lesión o comentario para el profesor? (Opcional)
            </label>
            <textarea
              id="notes"
              name="notes"
              rows="3"
              placeholder="Cuéntanos si tienes alguna molestia articular, embarazo o qué día te gustaría venir..."
              class="w-full rounded-xl border border-sand-300 bg-sand-100/50 px-4 py-3 text-sm text-ink-900 placeholder:text-ink-700/50 focus:border-terracotta-500 focus:bg-sand-50 focus:outline-none"
            ></textarea>
          </div>

          <button type="submit" class="btn-primary w-full !py-4 text-sm uppercase tracking-[0.16em]">
            Confirmar pre-reserva en Barranco
          </button>

          <!-- Mensaje de éxito -->
          <div
            id="booking-feedback"
            role="status"
            aria-live="polite"
            class="hidden rounded-2xl bg-sage-50 border border-sage-500/40 p-5 text-sm text-sage-900"
          ></div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('booking-form') as HTMLFormElement | null;
  const feedback = document.getElementById('booking-feedback');
  const interestInput = document.getElementById('interest') as HTMLInputElement | null;
  const selectButtons = document.querySelectorAll<HTMLElement>('[data-select-class]');

  // Cuando el usuario hace clic en "Reservar" desde una clase u horario, rellena el campo
  selectButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const chosen = btn.getAttribute('data-select-class');
      if (chosen && interestInput) {
        interestInput.value = chosen;
        interestInput.classList.add('ring-2', 'ring-terracotta-500');
        setTimeout(() => interestInput.classList.remove('ring-2', 'ring-terracotta-500'), 1800);
      }
    });
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!feedback) return;

    const formData = new FormData(form);
    const name = String(formData.get('name') || '').trim();
    const phone = String(formData.get('phone') || '').trim();
    const interest = String(formData.get('interest') || 'Clase de prueba').trim();

    if (!name || !phone) {
      feedback.classList.remove('hidden');
      feedback.innerHTML = 'Por favor ingresa tu <strong>nombre</strong> y número de <strong>WhatsApp</strong> para enviarte tu pase de ingreso.';
      return;
    }

    feedback.classList.remove('hidden');
    feedback.innerHTML = `
      <p class="font-serif text-xl font-semibold text-sage-900">¡Namasté, ${name}! Tu espacio ha sido reservado.</p>
      <p class="mt-1 text-xs sm:text-sm text-sage-800">Hemos registrado tu solicitud para <strong>${interest}</strong>. En breves minutos te escribiremos al <strong>${phone}</strong> con los detalles de bienvenida a nuestra casona en Jr. Domeyer 248, Barranco.</p>
    `;
    form.reset();
    if (interestInput) {
      interestInput.value = interest;
    }
  });
</script>
