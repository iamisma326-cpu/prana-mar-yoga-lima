---

<section id="horarios" class="py-24 md:py-32 bg-sand-100/80 border-t border-sand-200">
  <div class="editorial-container">
    <div class="text-center max-w-2xl mx-auto reveal-up">
      <span class="eyebrow justify-center">Horarios Semanales</span>
      <h2 class="mt-3 font-serif text-4xl sm:text-5xl text-ink-900 leading-tight">
        Encuentra tu momento en la <span class="italic font-normal text-terracotta-600">semana</span>.
      </h2>
      <p class="mt-4 text-sm sm:text-base text-ink-700">
        Abierto los 7 días de la semana. Llega 10 minutos antes; nosotros te esperamos con tu mat listo y agua filtrada con infusiones botánicas.
      </p>
    </div>

    <!-- Selector de días interactivo -->
    <div
      class="mt-10 flex items-center justify-start sm:justify-center gap-2 overflow-x-auto pb-3 no-scrollbar reveal-up"
      role="tablist"
      aria-label="Filtrar horario por día de la semana"
    >
      {days.map((d, index) => (
        <button
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          data-day-btn={d.id}
          class={`day-tab shrink-0 rounded-full px-5 py-2.5 text-xs uppercase tracking-[0.16em] font-semibold transition-all duration-300 ${
            index === 0
              ? 'bg-sage-800 text-sand-50 shadow-sm'
              : 'bg-sand-50 text-ink-800 border border-sand-300 hover:border-ink-800'
          }`}
        >
          {d.label}
        </button>
      ))}
    </div>

    <!-- Lista de sesiones -->
    <div class="mt-8 max-w-4xl mx-auto space-y-3.5">
      {scheduleItems.map((item) => (
        <div
          data-day-row={item.day}
          class={`schedule-row rounded-2xl bg-sand-50 border border-sand-300/90 p-5 sm:p-6 transition-all duration-300 hover:border-terracotta-500 hover:shadow-card ${
            item.day === 'lunes' ? 'block' : 'hidden'
          }`}
        >
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-7">
              <div class="sm:w-36 shrink-0">
                <span class="font-serif text-xl sm:text-2xl font-semibold text-ink-900 block">
                  {item.time}
                </span>
                <span class="text-xs text-ink-700">{item.room}</span>
              </div>

              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-serif text-2xl font-semibold text-ink-900">
                    {item.title}
                  </h3>
                  <span class="rounded-full bg-sand-200/90 px-2.5 py-0.5 text-[11px] font-medium text-ink-800">
                    {item.tag}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-ink-700 mt-1">
                  Guía: <strong class="font-medium text-ink-900">{item.teacher}</strong>
                </p>
              </div>
            </div>

            <div class="flex items-center justify-between sm:justify-end gap-4 pt-3 sm:pt-0 border-t sm:border-t-0 border-sand-200">
              <span class="text-xs font-medium text-sage-700 bg-sage-50 border border-sage-100 px-3 py-1 rounded-full">
                {item.spots}
              </span>
              <a
                href="#contacto"
                data-select-class={`${item.title} (${item.time})`}
                class="select-class-btn inline-flex items-center justify-center rounded-full bg-ink-900 px-4 py-2 text-xs uppercase tracking-[0.14em] font-medium text-sand-50 hover:bg-terracotta-600 transition-colors"
              >
                Reservar
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Planes / Membresías resumen -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">
      <div class="reveal-card rounded-3xl bg-sand-50 border border-sand-300 p-7 flex flex-col justify-between">
        <div>
          <span class="text-xs uppercase tracking-[0.18em] text-terracotta-600 font-semibold">Nuevos Alumnos</span>
          <h3 class="mt-2 font-serif text-2xl font-semibold text-ink-900">Semana Introductoria</h3>
          <p class="mt-1 text-xs text-ink-700">7 días consecutivos de acceso ilimitado a todas las disciplinas.</p>
          <p class="mt-5 font-serif text-4xl font-semibold text-ink-900">
            S/ 89 <span class="text-xs font-sans font-normal text-ink-700">/ único pago</span>
          </p>
        </div>
        <a href="#contacto" data-select-class="Pack Semana Introductoria (S/ 89)" class="select-class-btn mt-6 btn-outline w-full text-center !py-2.5 text-xs uppercase tracking-[0.15em]">
          Solicitar Pack Intro
        </a>
      </div>

      <div class="reveal-card rounded-3xl bg-sage-900 text-sand-50 border border-sage-700 p-7 flex flex-col justify-between relative shadow-soft">
        <span class="absolute top-4 right-4 rounded-full bg-terracotta-500 px-3 py-0.5 text-[10px] uppercase tracking-[0.16em] font-semibold text-sand-50">
          Más elegido
        </span>
        <div>
          <span class="text-xs uppercase tracking-[0.18em] text-terracotta-400 font-semibold">Práctica Constante</span>
          <h3 class="mt-2 font-serif text-2xl font-semibold">Paquete 8 Clases</h3>
          <p class="mt-1 text-xs text-sand-200">Válido por 45 días. Incluye préstamo de mat Manduka Pro y toalla.</p>
          <p class="mt-5 font-serif text-4xl font-semibold">
            S/ 340 <span class="text-xs font-sans font-normal text-sand-200">/ S/ 42.5 por clase</span>
          </p>
        </div>
        <a href="#contacto" data-select-class="Paquete 8 Clases Mensual (S/ 340)" class="select-class-btn mt-6 rounded-full bg-terracotta-500 hover:bg-terracotta-600 text-sand-50 py-2.5 text-center text-xs uppercase tracking-[0.15em] font-medium transition-colors">
          Elegir 8 Clases
        </a>
      </div>

      <div class="reveal-card rounded-3xl bg-sand-50 border border-sand-300 p-7 flex flex-col justify-between">
        <div>
          <span class="text-xs uppercase tracking-[0.18em] text-terracotta-600 font-semibold">Libertad Total</span>
          <h3 class="mt-2 font-serif text-2xl font-semibold text-ink-900">Membresía Mensual</h3>
          <p class="mt-1 text-xs text-ink-700">Clases ilimitadas + 1 invitado gratis al mes + 15% dcto. en talleres.</p>
          <p class="mt-5 font-serif text-4xl font-semibold text-ink-900">
            S/ 460 <span class="text-xs font-sans font-normal text-ink-700">/ mes</span>
          </p>
        </div>
        <a href="#contacto" data-select-class="Membresía Mensual Ilimitada (S/ 460)" class="select-class-btn mt-6 btn-outline w-full text-center !py-2.5 text-xs uppercase tracking-[0.15em]">
          Elegir Ilimitado
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const dayButtons = document.querySelectorAll<HTMLButtonElement>('[data-day-btn]');
  const dayRows = document.querySelectorAll<HTMLElement>('[data-day-row]');

  dayButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selectedDay = btn.getAttribute('data-day-btn');
      if (!selectedDay) return;

      dayButtons.forEach((b) => {
        const isActive = b === btn;
        b.setAttribute('aria-selected', String(isActive));
        b.classList.toggle('bg-sage-800', isActive);
        b.classList.toggle('text-sand-50', isActive);
        b.classList.toggle('shadow-sm', isActive);
        b.classList.toggle('bg-sand-50', !isActive);
        b.classList.toggle('text-ink-800', !isActive);
        b.classList.toggle('border', !isActive);
        b.classList.toggle('border-sand-300', !isActive);
      });

      dayRows.forEach((row) => {
        const matches = row.getAttribute('data-day-row') === selectedDay;
        row.classList.toggle('hidden', !matches);
        row.classList.toggle('block', matches);
      });
    });
  });
</script>
